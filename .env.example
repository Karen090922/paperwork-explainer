# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so your keys never reach GitHub.

# Which AI provider to use: google_genai, anthropic or openai
LLM_PROVIDER=google_genai

# Optional: a specific model. Leave empty to use the default for your provider:
#   google_genai -> gemini-3.8-flash  (free tier; if you hit the daily limit, try gemini-3.1-flash-lite)
#   anthropic    -> claude-haiku-5-5
#   openai       -> gpt-5-mini
LLM_MODEL=

# Optional: only set this if your model supports it. Newer models ignore or reject it.
LLM_TEMPERATURE=

# Fill in the key for the provider you chose. Get a free Google key at aistudio.google.com
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
